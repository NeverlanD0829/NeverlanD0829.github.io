{{- $pages := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
  {{- $pages = $pages | append (dict "title" .Title "url" .RelPermalink "date" (.Date.Format "2006.01.02") "description" (.Description | default (.Summary | plainify)) "tags" (.Params.tags | default slice) "content" .Plain) -}}
{{- end -}}
{{- $pages | jsonify -}}
